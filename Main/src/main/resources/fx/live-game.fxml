<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.LiveGameController"
            style="-fx-background-color: white;">

    <VBox spacing="30"
          alignment="TOP_CENTER"
          AnchorPane.topAnchor="30"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">

        <!-- Title -->
        <Label text="Gin Rummy Live Scoring"
               style="-fx-font-size: 42; -fx-font-weight: bold;" />

        <!-- Subheading -->
        <Label fx:id="turnLabel"
               text="Player 1 goes first this round"
               style="-fx-font-size: 18;" />

        <!-- Players section (side by side) -->
        <HBox spacing="250"
              alignment="TOP_CENTER">

            <!-- Player 1 column -->
            <VBox spacing="15" alignment="CENTER" prefWidth="400">

                <Label fx:id="p1name"
                       style="-fx-font-size: 24; -fx-font-weight: bold;" />

                <!-- Full width HBox for image + score -->
                <HBox alignment="CENTER_LEFT" spacing="10" prefWidth="400">
                    <ImageView fx:id="p1image" fitWidth="200" fitHeight="200"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label fx:id="p1score"
                           text="0"
                           style="-fx-font-size: 128; -fx-font-weight: bold;" />

                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <TextField fx:id="p1textField"
                           promptText="Enter score"
                           maxWidth="120"
                           style="-fx-font-size: 18; -fx-alignment: center;" />

            </VBox>

            <!-- Player 2 column -->
            <VBox spacing="15" alignment="CENTER" prefWidth="400">

                <Label fx:id="p2name"
                       style="-fx-font-size: 24; -fx-font-weight: bold;" />

                <!-- Full width HBox for score + image -->
                <HBox alignment="CENTER_RIGHT" spacing="10" prefWidth="400">
                    <Region HBox.hgrow="ALWAYS"/>

                    <Label fx:id="p2score"
                           text="0"
                           style="-fx-font-size: 128; -fx-font-weight: bold;" />

                    <Region HBox.hgrow="ALWAYS"/>

                    <ImageView fx:id="p2image" fitWidth="200" fitHeight="200"/>
                </HBox>

                <TextField fx:id="p2textField"
                           promptText="Enter score"
                           maxWidth="120"
                           style="-fx-font-size: 18; -fx-alignment: center;" />

            </VBox>

        </HBox>

        <!-- Single submit button -->
        <Button text="Submit Score"
                onAction="#handleSubmitScore"
                prefWidth="200"
                prefHeight="50"
                style="-fx-font-size: 20;" />

        <!-- Error label -->
        <Label fx:id="errorLabel"
               style="-fx-text-fill: red; -fx-font-size: 12;"
               visible="false" managed="false" wrapText="true"
               alignment="CENTER" />

        <!-- Round history -->
        <VBox fx:id="roundLogBox"
              spacing="2"
              alignment="CENTER"
              style="-fx-padding: 10;" />

        <Pane prefHeight="150"/>
    </VBox>

    <!-- Exit button pinned top-right -->
    <Button text="Quit Game"
            onAction="#handleQuitGame"
            prefWidth="100"
            prefHeight="20"
            style="-fx-text-fill: red; -fx-font-size: 14;"
            AnchorPane.topAnchor="10"
            AnchorPane.rightAnchor="10" />

</AnchorPane>
