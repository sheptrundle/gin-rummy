<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.HistoryController"
            prefWidth="600"
            prefHeight="400">

    <top>
        <Label text="History"
               style="-fx-font-size: 24; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <!-- Two tables side by side -->
        <HBox alignment="CENTER" spacing="50">

            <!-- History table with label -->
            <VBox alignment="TOP_CENTER" spacing="5">
                <Label text="Matchups"
                       style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                <TableView fx:id="historyTable"
                           prefWidth="324" prefHeight="500"
                           maxWidth="324" maxHeight="500"
                           style="-fx-border-color: black; -fx-border-width: 1; -fx-background-color: white;">
                    <columns>
                        <TableColumn fx:id="name1Column" text="P1" prefWidth="100"/>
                        <TableColumn fx:id="wins1Column" text="P1 wins" prefWidth="60"/>
                        <TableColumn fx:id="name2Column" text="P2" prefWidth="100"/>
                        <TableColumn fx:id="wins2Column" text="P2 wins" prefWidth="60"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Totals table with label -->
            <VBox alignment="TOP_CENTER" spacing="5">
                <Label text="Individual Totals"
                       style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                <TableView fx:id="totalsTable"
                           prefWidth="304" prefHeight="500"
                           maxWidth="304" maxHeight="500"
                           style="-fx-border-color: black; -fx-border-width: 1; -fx-background-color: white;">
                    <columns>
                        <TableColumn fx:id="totalsNameColumn" text="Player" prefWidth="120"/>
                        <TableColumn fx:id="totalsWinsColumn" text="Wins" prefWidth="60"/>
                        <TableColumn fx:id="totalsLossesColumn" text="Losses" prefWidth="60"/>
                        <TableColumn fx:id="totalsPctColumn" text="Pct" prefWidth="60"/>
                    </columns>
                </TableView>
            </VBox>

        </HBox>
    </center>

    <bottom>
        <VBox alignment="CENTER">
            <padding>
                <Insets bottom="70"/>
            </padding>
            <Button text="Back"
                    prefHeight="50"
                    prefWidth="150"
                    onAction="#handleBack"
                    style="-fx-font-size: 16; -fx-background-color: darkred; -fx-text-fill: white"/>
        </VBox>
    </bottom>

</BorderPane>



